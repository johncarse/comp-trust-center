# Base URL of the Comp AI instance's API, used server-side to fetch published
# trust portal content.
COMP_API_URL=https://api.your-comp-instance.example.com

# Comp API base URL as reachable FROM THE BROWSER, so the request-access
# dialog can POST directly to Comp's public access-request endpoint. Often
# differs from COMP_API_URL above, which may be a cluster-internal address.
# Intentionally not NEXT_PUBLIC_*: that would bake the value into the image at
# build time instead of letting each deployment set it.
COMP_PUBLIC_API_URL=https://api.your-comp-instance.example.com

# Maps inbound Host headers to a Comp organization's friendlyUrl so one
# deployment can serve every tenant. An unmapped Host always 404s — there is
# no default tenant.
# Format: host1=friendlyUrl1,host2=friendlyUrl2
TRUST_TENANTS=trust.acme.com=acme
