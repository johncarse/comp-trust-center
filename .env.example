# Base URL of the Comp AI instance's API, read server-side at request time.
# Used both to fetch published trust portal content and, passed down to the
# client as a prop, to let the request-access dialog POST to Comp's public
# access-request endpoint. Never expose this as a NEXT_PUBLIC_ variable: that
# would get inlined into the build instead of read at runtime.
COMP_API_URL=https://api.your-comp-instance.example.com

# Maps inbound Host headers to a Comp organization's friendlyUrl so one
# deployment can serve every tenant. An unmapped Host always 404s — there is
# no default tenant.
# Format: host1=friendlyUrl1,host2=friendlyUrl2
TRUST_TENANTS=trust.acme.com=acme
